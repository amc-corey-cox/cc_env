#!/bin/bash
# Non-interactive shell initialization (sourced via BASH_ENV)
# Ensures PATH, tool shims, and project venvs are available in
# non-interactive shells (e.g. Claude Code, scripts, CI)

# PATH and tool setup (mise, pyenv, nvm, etc.)
if [[ -r "$HOME/.bash.d/.bash_paths" ]]; then
    . "$HOME/.bash.d/.bash_paths"
fi

# Auto-activate project venv based on working directory
# Each command gets a fresh shell, so this re-evaluates every time
_dir="$PWD"
while [[ "$_dir" != "/" ]]; do
    if [[ -d "$_dir/.venv/uv-venv/bin" ]]; then
        export VIRTUAL_ENV="$_dir/.venv/uv-venv"
        _prepend_path "$VIRTUAL_ENV/bin"
        break
    elif [[ -d "$_dir/.venv/bin" ]]; then
        export VIRTUAL_ENV="$_dir/.venv"
        _prepend_path "$VIRTUAL_ENV/bin"
        break
    fi
    _dir=$(dirname "$_dir")
done
unset _dir

# Use the nearest .nvmrc Node version (without loading nvm.sh, which is slow)
# Resolves numeric versions only (e.g. 22, v22.1); aliases like lts/* are skipped
_dir="$PWD"
while [[ "$_dir" != "/" ]]; do
    if [[ -r "$_dir/.nvmrc" ]]; then
        _nvm_ver=$(< "$_dir/.nvmrc")
        _nvm_ver="${_nvm_ver//[[:space:]]/}"
        _nvm_ver="${_nvm_ver#v}"
        # Match the version exactly or as a dotted prefix, so 2 doesn't pick v20
        if [[ "$_nvm_ver" =~ ^[0-9]+(\.[0-9]+){0,2}$ ]]; then
            _nvm_path=$(ls -d "$NVM_DIR/versions/node/v$_nvm_ver" "$NVM_DIR/versions/node/v$_nvm_ver".* 2>/dev/null | sort -V | tail -1)
            if [[ -n "$_nvm_path" ]]; then
                _prepend_path "$_nvm_path/bin"
            fi
        fi
        break
    fi
    _dir=$(dirname "$_dir")
done
unset _dir _nvm_ver _nvm_path
