#!/bin/bash
# Interactive shell setup: completions, shell hooks, and tool activation
# Sourced from .bashrc after the non-interactive guard
# PATH and environment setup is in .bash_paths (sourced for all shells)

# The next line enables shell command completion for gcloud.
if [ -f "$HOME/.local/google-cloud-sdk/completion.bash.inc" ]; then . "$HOME/.local/google-cloud-sdk/completion.bash.inc"; fi

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi

# nvm - full initialization and bash completion
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# nvm - switch to the nearest .nvmrc version on directory change, back to default outside
# Only affects the current shell; never changes the nvm default alias
_nvm_auto_use() {
    [[ "$PWD" == "${_nvm_last_pwd:-}" ]] && return
    _nvm_last_pwd="$PWD"
    local nvmrc pinned want
    nvmrc="$(nvm_find_nvmrc)"
    if [[ -n "$nvmrc" ]]; then
        pinned="$(< "$nvmrc")"
        want="$(nvm version "$pinned")"
        if [[ "$want" == "N/A" ]]; then
            echo "nvm: Node $pinned from $nvmrc is not installed (run: nvm install)" >&2
            return
        fi
    else
        want="$(nvm version default)"
        [[ "$want" == "N/A" ]] && return
    fi
    [[ "$want" == "$(nvm current)" ]] || nvm use --silent "$want"
}
if command -v nvm_find_nvmrc >/dev/null; then
    PROMPT_COMMAND="_nvm_auto_use${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
fi

# pyenv interactive shell integration
eval "$(pyenv init -)"

# mise interactive shell hooks and completions
eval "$(mise activate bash)"
source <(mise completions bash)
